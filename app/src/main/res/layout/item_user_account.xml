<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Role Icon Avatar -->
        <FrameLayout
            android:id="@+id/layout_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_client_avatar">

            <ImageView
                android:id="@+id/iv_user_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_admin"
                app:tint="@color/primary" />
        </FrameLayout>

        <!-- User Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                tools:text="Andrea Admin" />

            <TextView
                android:id="@+id/tv_user_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:layout_marginTop="2dp"
                tools:text="andrea@test.it" />

            <!-- Role & Department Badge -->
            <TextView
                android:id="@+id/tv_user_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_hero_pill"
                android:textColor="#1E293B"
                tools:text="Amministratore • Direzione" />
        </LinearLayout>

        <!-- Actions Row for Team Operations -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Assign Work Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_assign_task"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_assign_task"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary_light"
                app:strokeWidth="1dp"
                android:backgroundTint="#FCF0F0"
                android:contentDescription="Assegna Lavoro" />

            <!-- Call Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_call_user"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_call_tonal"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary_light"
                app:strokeWidth="1dp"
                android:backgroundTint="#FCF0F0"
                android:contentDescription="Chiama" />

            <!-- Message Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_message_user"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_message"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary_light"
                app:strokeWidth="1dp"
                android:backgroundTint="#FCF0F0"
                android:contentDescription="Messaggio" />

            <!-- Edit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_user"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="#64748B"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                android:backgroundTint="#F8FAFC"
                android:contentDescription="Personalizza Account" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_user"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="#EF4444"
                app:strokeColor="#FCA5A5"
                app:strokeWidth="1dp"
                android:backgroundTint="#FEF2F2"
                android:contentDescription="Elimina Account" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
