        android:fillColor="#2E2E2E"
        android:pathData="M18,43 L32,18 L81,44 L67,69 Z"/>

    <!-- Braccio inferiore diagonale: blob bottom-left → blob right
         Simmetrico rispetto al precedente -->
    <path
        android:fillColor="#2E2E2E"
        android:pathData="M18,65 L32,90 L81,64 L67,39 Z"/>

    <!-- Blob top-left: cx=25, cy=30, r=13 -->
    <path
        android:fillColor="#2E2E2E"
        android:pathData="M12,30 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"/>

    <!-- Blob bottom-left: cx=25, cy=78, r=13 -->
    <path
        android:fillColor="#2E2E2E"
        android:pathData="M12,78 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"/>

    <!-- Blob right (più grande): cx=74, cy=54, r=17 -->
    <path
        android:fillColor="#2E2E2E"
        android:pathData="M57,54 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0"/>

    <!-- Pallino arancione Xelta: cx=86, cy=20, r=11 -->
    <path
        android:fillColor="#F07820"
        android:pathData="M75,20 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"/>

