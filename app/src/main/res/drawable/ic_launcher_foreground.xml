    <!--
        XELTA LOGO — fedele all'originale:
        3 blob scuri connessi (2 a sinistra, 1 a destra)
        + pallino arancione in alto a destra separato.

        Blob centers:
          Top-left:    (25, 30), r=13
          Bottom-left: (25, 78), r=13
          Right:       (74, 54), r=17

        Orange dot:    (86, 20), r=11
    -->

    <!-- Braccio verticale: connette i due blob di sinistra -->
    <path
        android:fillColor="#2E2E2E"
        android:pathData="M12,30 L38,30 L38,78 L12,78 Z"/>

    <!-- Braccio superiore diagonale: blob top-left → blob right
         Quadrilatero: perpendicolare alla retta (25,30)→(74,54),
         semilarghezza 12 -->
